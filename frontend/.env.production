# Used by `vite build` (Netlify's build step) instead of .env's localhost default.
# Update this to the actual Render backend URL once the first deploy is live —
# Render assigns the URL after the service is created, so this is a placeholder
# until then. Format: https://trackpulse-backend-xxxx.onrender.com (no trailing slash)
VITE_API_BASE=https://trackpulse-backend.onrender.com
